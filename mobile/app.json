{
  "expo": {
    "name": "Pocksy",
    "slug": "pocksy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pocksy",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pocksy.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Pocksy to use Face ID or Biometrics to securely authenticate and protect your financial records.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pocksy.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#6B1E2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "name": "Pocksy — Smart Wealth & Expense Tracker",
      "shortName": "Pocksy",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B1E2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pocksy to use Face ID to securely authenticate and protect your financial records."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://pocksy-bies.onrender.com/api",
      "router": {},
      "eas": {
        "projectId": "dc0f52e1-fabc-40c2-8ed1-001cd1fb9a8d"
      }
    }
  }
}
